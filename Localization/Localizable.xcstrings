      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quelle fréquence Porthole lit les avertissements et erreurs du dernier jour, pour l’aperçu et les alertes de nouvelles erreurs"
          }
        }
      }
    },
