    "A stack's log merges its containers' logs in time order, and each line says which container wrote it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal d’une pile réunit ceux de ses conteneurs dans l’ordre chronologique, et chaque ligne indique quel conteneur l’a écrite."
          }
        }
      }
    },
